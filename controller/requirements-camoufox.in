# The Camoufox Browser API's dependencies (controller/Dockerfile.camoufox,
# Python 3.12): pyproject.toml's [project].dependencies without patchright,
# plus stock Playwright at the exact version the Camoufox browser's server
# runs (camoufox/uv.lock; CI checks they agree).
#
# Regenerate the hashed requirements-camoufox.txt after any change here, held
# to the versions the Chrome controller runs (uv.lock) where both use a package:
#   python3 -c 'import tomllib; [print(f"{p[\"name\"]}=={p[\"version\"]}") for p in
#     tomllib.load(open("uv.lock","rb"))["package"] if p["name"] not in
#     ("livellm-controller","patchright")]' > uv-lock-versions.txt
#   uv pip compile --generate-hashes --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 -c uv-lock-versions.txt \
#     -o requirements-camoufox.txt requirements-camoufox.in
#   rm uv-lock-versions.txt

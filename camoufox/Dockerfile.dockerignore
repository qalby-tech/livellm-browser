# The Camoufox image is built from the repo root: only what it copies.
*
!camoufox/
!browser/keeper/
!browser/startup.sh
!browser/locales.json
camoufox/.venv
camoufox/**/__pycache__
camoufox/.pytest_cache
camoufox/tests
camoufox/profiles
browser/keeper/keeper
browser/keeper/*_test.go
browser/keeper/testdata

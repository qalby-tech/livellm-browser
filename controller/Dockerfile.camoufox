# The Camoufox Browser API (kamasalyamov/livellm-browser:camoufox-api-<v>,
# <v> = camoufox/pyproject.toml): the same controller code as ./Dockerfile,
# on Python 3.12 with stock Playwright, the client a Camoufox browser's own
# Playwright server accepts, instead of patchright. core/pw.py picks it by
# BROWSER_ENGINE. Every dependency is pinned by hash.
FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BROWSER_ENGINE=camoufox \
    HOME=/tmp

WORKDIR /app
COPY requirements-camoufox.txt ./
RUN pip install --no-cache-dir --require-hashes --no-deps -r requirements-camoufox.txt

COPY . /app
# Python 3.12 runs the 3.9 code as is; the image's own checks.
RUN python -c "import core.pw as pw; assert pw.ENGINE == 'camoufox'; assert pw.async_playwright.__module__.startswith('playwright.')" && \
    python -c "import main"

USER 1000:1000
EXPOSE 8000
CMD ["python", "main.py"]
